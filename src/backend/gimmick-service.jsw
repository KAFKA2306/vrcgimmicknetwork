import wixData from 'wix-data';
import { ContentValidator } from './content-validator';
import { optimizeImage } from './image-optimizer';

export async function prepareGimmickForInsert(data, { validate = ContentValidator.validateGimmick, prepareImage = optimizeImage } = {}) {
    const validation = validate(data);
    if (!validation.valid) {
        throw new Error(validation.errors.join(', '));
    }

    const prepared = { ...data };
    if (prepared.mainImage) {
        prepared.mainImage = await prepareImage(prepared.mainImage, {
            format: 'webp',
            quality: 80,
            resize: { width: 1200, height: 900 }
        });
    }
    return prepared;
}

export const GimmickService = {
    createGimmick: async (data) => {
        const prepared = await prepareGimmickForInsert(data);
        return wixData.insert('GimmickInfo', prepared);
    },

    getGimmick: async (id) => wixData.get('GimmickInfo', id),

    getGimmicks: async (options = {}) => {
        const { limit = 10, skip = 0, sort = '_createdDate', order = 'desc' } = options;
        let query = wixData.query('GimmickInfo');
        query = order === 'desc' ? query.descending(sort) : query.ascending(sort);
        return query.limit(limit).skip(skip).find();
    },

    searchGimmicks: async (keyword, options = {}) => {
        const { limit = 10, skip = 0, category = null } = options;
        let query = wixData.query('GimmickInfo');
        if (keyword) {
            query = query.contains('title', keyword)
                .or(wixData.query('GimmickInfo').contains('content', keyword));
        }
        if (category) query = query.hasSome('gimmickCategory', [category]);
        return query.descending('_createdDate').limit(limit).skip(skip).find();
    },

    getCategories: async () => {
        const results = await wixData.query('GimmickInfo').limit(1000).find();
        const categories = new Set();
        results.items.forEach((item) => {
            if (Array.isArray(item.gimmickCategory)) item.gimmickCategory.forEach((cat) => categories.add(cat));
            else if (item.gimmickCategory) categories.add(item.gimmickCategory);
        });
        return Array.from(categories);
    },

    getTags: async () => {
        const results = await wixData.query('GimmickInfo').limit(1000).find();
        const tags = new Set();
        results.items.forEach((item) => {
            if (Array.isArray(item.gimmickTag)) item.gimmickTag.forEach((tag) => tags.add(tag));
            else if (item.gimmickTag) tags.add(item.gimmickTag);
        });
        return Array.from(tags);
    },

    getRelatedGimmicks: async (currentId, category, limit = 5) => wixData.query('GimmickInfo')
        .ne('_id', currentId)
        .hasSome('gimmickCategory', Array.isArray(category) ? category : [category])
        .limit(limit)
        .find()
};
